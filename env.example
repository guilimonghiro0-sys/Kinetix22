# ─────────────────────────────────────────────────────────────
#  KINETIX — Variables d'environnement (formulaire de contact)
#  Copier ce fichier en `.env` en local, et configurer les mêmes
#  variables dans Vercel → Project Settings → Environment Variables.
#  NE JAMAIS committer le vrai `.env`.
# ─────────────────────────────────────────────────────────────

# Clé API Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Adresse qui RECEVRA les leads (ta boîte mail)
CONTACT_TO_EMAIL=hello@kinetix.fun

# Expéditeur affiché. DOIT utiliser un domaine VÉRIFIÉ dans Resend.
# Tant que kinetix.fun n'est pas vérifié, laisse la valeur de test ci-dessous.
#   Test  : Kinetix <onboarding@resend.dev>
#   Prod  : Kinetix <contact@kinetix.fun>
CONTACT_FROM_EMAIL=Kinetix <onboarding@resend.dev>
